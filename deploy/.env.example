# NetPulse Environment Configuration
# Copy this file to network-monitor/.env and update values

# SMTP Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_TO=alerts@yourdomain.com

# Alert Settings
ALERTS_ENABLED=true
ALERT_DOWN_COOLDOWN=5
ALERT_DEGRADED_COOLDOWN=15
ALERT_RECOVERY_COOLDOWN=5
ALERT_ERRATIC_COOLDOWN=30
ALERT_FLAPPING_SUPPRESSION=60

# Quality Thresholds
DOWN_SUCCESS_RATE_THRESHOLD=30.0
DOWN_PACKET_LOSS_THRESHOLD=50.0
