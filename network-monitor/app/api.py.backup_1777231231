@app.delete("/api/user/alert-email", tags=["User"])
async def remove_alert_email(
    token: str = Query(...),
    alert_email: str = Query(...)
):
    """Remove alert email from user"""
    # Create a new database connection
    conn = sqlite3.connect("data/monitor.db")
    conn.row_factory = sqlite3.Row
    cursor = conn.cursor()
    
    try:
        # First check if token is valid
        cursor.execute("SELECT id FROM users WHERE token = ?", (token,))
        user_row = cursor.fetchone()
        
        if not user_row:
            conn.close()
            raise HTTPException(status_code=401, detail="Invalid token")
        
        user_id = user_row[0]
        
        # Clear alert email if it matches
        cursor.execute(
            "UPDATE users SET alert_email = NULL WHERE id = ? AND alert_email = ?",
            (user_id, alert_email)
        )
        conn.commit()
        
        # Check if any rows were affected
        if cursor.rowcount > 0:
            conn.close()
            return {"success": True, "message": f"Alert email {alert_email} removed successfully"}
        else:
            conn.close()
            return {"success": False, "message": "Email not found or already removed"}
    except Exception as e:
        conn.close()
        raise HTTPException(status_code=500, detail=str(e))

