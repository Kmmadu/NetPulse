# NetPulse desktop app — example configuration.
#
# Copy this file to .env and fill in your own values:
#     cp .env.example .env
#     nano .env
#
# The .env file contains your SMTP password. It is gitignored and
# must never be committed.

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_TO=alerts@yourdomain.com

ALERTS_ENABLED=true
ALERT_DOWN_COOLDOWN=5
ALERT_RECOVERY_COOLDOWN=5
ALERT_ERRATIC_COOLDOWN=30
ALERT_FLAPPING_SUPPRESSION=60